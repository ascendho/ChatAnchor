{
  "name": "@ascendho/threadrelink",
  "version": "0.5.0",
  "description": "Find and resume local Codex conversations after a repository is renamed or moved.",
  "keywords": [
    "codex",
    "conversation",
    "repository",
    "rename"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ascendho/ThreadRelink.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ascendho/ThreadRelink#readme",
  "bugs": {
    "url": "https://github.com/ascendho/ThreadRelink/issues"
  },
  "type": "module",
  "bin": {
    "threadrelink": "./dist/index.js",
    "reporecall": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@threadrelink/core": "workspace:*",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
