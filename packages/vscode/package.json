{
  "name": "threadrelink",
  "displayName": "ChatAnchor",
  "description": "A VS Code extension that keeps AI coding agent conversations connected to their projects after folders are renamed or moved.",
  "version": "1.0.11",
  "icon": "resources/threadrelink.png",
  "publisher": "ascendho",
  "repository": {
    "type": "git",
    "url": "https://github.com/ascendho/ChatAnchor.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/ascendho/ChatAnchor#readme",
  "bugs": {
    "url": "https://github.com/ascendho/ChatAnchor/issues"
  },
  "license": "GPL-3.0-only",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#315EF3",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
    "keywords": [
    "chatanchor",
    "codex",
    "conversation",
    "history",
    "repository",
    "rename"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onView:threadrelink.conversations"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "ChatAnchor starts local agent CLIs and reads local Codex, Cursor, and OpenCode conversation metadata."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "threadrelink.enable",
        "title": "ChatAnchor: Enable Local Metadata Scan",
        "icon": "$(shield)"
      },
      {
        "command": "threadrelink.openGettingStarted",
        "title": "ChatAnchor: Open Getting Started",
        "icon": "$(book)"
      },
      {
        "command": "threadrelink.openView",
        "title": "ChatAnchor: Open Conversations View",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "threadrelink.initialize",
        "title": "ChatAnchor: Set Up This Project",
        "icon": "$(key)"
      },
      {
        "command": "threadrelink.findOldConversations",
        "title": "ChatAnchor: Find Old Conversations",
        "icon": "$(search)"
      },
      {
        "command": "threadrelink.collapseTree",
        "title": "ChatAnchor: Collapse Conversations",
        "icon": "$(collapse-all)"
      },
      {
        "command": "threadrelink.expandTree",
        "title": "ChatAnchor: Expand Conversations",
        "icon": "$(expand-all)"
      },
      {
        "command": "threadrelink.forgetProject",
        "title": "ChatAnchor: Forget Project",
        "icon": "$(trash)"
      },
      {
        "command": "threadrelink.refresh",
        "title": "ChatAnchor: Refresh Conversations",
        "icon": "$(refresh)"
      },
      {
        "command": "threadrelink.startNewSession",
        "title": "ChatAnchor: Start New Agent Session...",
        "icon": "$(terminal-new)"
      },
      {
        "command": "threadrelink.confirmLink",
        "title": "ChatAnchor: Link Conversation to This Project",
        "icon": "$(link)"
      },
      {
        "command": "threadrelink.unlink",
        "title": "ChatAnchor: Remove Conversation from This Project",
        "icon": "$(remove-close)"
      },
      {
        "command": "threadrelink.move",
        "title": "ChatAnchor: Move Conversation to Another Project",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "threadrelink.manageLink",
        "title": "ChatAnchor: Manage Conversation Link...",
        "icon": "$(tools)"
      },
      {
        "command": "threadrelink.editDescription",
        "title": "ChatAnchor: Edit Conversation Description",
        "icon": "$(edit)"
      },
      {
        "command": "threadrelink.hideConversation",
        "title": "ChatAnchor: Hide Conversation",
        "icon": "$(eye-closed)"
      },
      {
        "command": "threadrelink.showConversation",
        "title": "ChatAnchor: Unhide Conversation",
        "icon": "$(eye)"
      },
      {
        "command": "threadrelink.noHiddenConversations",
        "title": "ChatAnchor: No Hidden Conversations",
        "icon": "$(eye)"
      },
      {
        "command": "threadrelink.showHiddenConversations",
        "title": "ChatAnchor: Show Hidden Conversations",
        "icon": "$(eye-closed)"
      },
      {
        "command": "threadrelink.hideHiddenConversations",
        "title": "ChatAnchor: Hide Hidden Conversations",
        "icon": "$(eye)"
      },
      {
        "command": "threadrelink.restoreHiddenConversations",
        "title": "ChatAnchor: Unhide All Conversations",
        "icon": "$(clear-all)"
      },
      {
        "command": "threadrelink.resume",
        "title": "ChatAnchor: Resume Conversation Here",
        "icon": "$(debug-continue)"
      },
      {
        "command": "threadrelink.copyAtPath",
        "title": "ChatAnchor: Copy @ Conversation Path",
        "icon": "$(mention)"
      },
      {
        "command": "threadrelink.exportOpenCodeAtPath",
        "title": "ChatAnchor: Export OpenCode JSON and Copy @ Path",
        "icon": "$(file-code)"
      },
      {
        "command": "threadrelink.copyCompactAtPath",
        "title": "ChatAnchor: Copy Compact @ Transcript",
        "icon": "$(file-text)"
      },
      {
        "command": "threadrelink.revealLocation",
        "title": "ChatAnchor: Reveal Conversation File",
        "icon": "$(folder-opened)"
      },
      {
        "command": "threadrelink.relink",
        "title": "ChatAnchor: Relink Previous Project Path",
        "icon": "$(folder-symlink)"
      },
      {
        "command": "threadrelink.doctor",
        "title": "ChatAnchor: Run Diagnostics",
        "icon": "$(stethoscope)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "threadrelink",
          "title": "ChatAnchor",
          "icon": "resources/threadrelink.svg"
        }
      ]
    },
    "views": {
      "threadrelink": [
        {
          "id": "threadrelink.conversations",
          "name": "Conversations"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "threadrelink.conversations",
        "contents": "Open a project folder to use ChatAnchor.\n[Open Getting Started](command:threadrelink.openGettingStarted)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "walkthroughs": [
      {
        "id": "threadrelink.gettingStarted",
        "title": "Keep AI conversations after a project rename",
        "description": "Initialize once, then resume available local Codex, Cursor, or OpenCode threads from any renamed or moved path. Each provider is detected independently.",
        "steps": [
          {
            "id": "threadrelink.gettingStarted.openView",
            "title": "Find ChatAnchor",
            "description": "Open the ChatAnchor icon in the Activity Bar. If it is hidden, right-click the Activity Bar and enable **ChatAnchor**.\n[Open ChatAnchor](command:threadrelink.openView)",
            "media": {
              "image": "media/guide/02-find-threadrelink.png",
              "altText": "ChatAnchor icon highlighted in the VS Code Activity Bar"
            },
            "completionEvents": [
              "onCommand:threadrelink.openView"
            ]
          },
          {
            "id": "threadrelink.gettingStarted.enable",
            "title": "Allow the metadata-only scan",
            "description": "Allow metadata access once for this VS Code profile. New projects are never scanned until you explicitly set them up.\n[Enable metadata scan](command:threadrelink.enable)",
            "media": {
              "image": "media/guide/03-enable-and-initialize.png",
              "altText": "ChatAnchor setup action before a project is scanned"
            },
            "completionEvents": [
              "onCommand:threadrelink.enable"
            ]
          },
          {
            "id": "threadrelink.gettingStarted.initialize",
            "title": "Set up this project explicitly",
            "description": "Store a stable local project ID before renaming or moving the folder. A folder inside a parent Git repository always asks you to choose its boundary.\n[Set Up This Project](command:threadrelink.initialize)",
            "media": {
              "image": "media/guide/03-enable-and-initialize.png",
              "altText": "Set Up This Project action in the ChatAnchor view"
            },
            "completionEvents": [
              "onCommand:threadrelink.initialize"
            ]
          },
          {
            "id": "threadrelink.gettingStarted.reopen",
            "title": "Rename and reopen the folder",
            "description": "Close any active agent terminal, rename the folder outside VS Code, reopen the new path, then refresh ChatAnchor.\n[Refresh conversations](command:threadrelink.refresh)",
            "media": {
              "image": "media/guide/04-resume-after-rename.png",
              "altText": "A renamed project with linked AI coding conversations"
            },
            "completionEvents": [
              "onCommand:threadrelink.refresh"
            ]
          },
          {
            "id": "threadrelink.gettingStarted.resume",
            "title": "Resume or start an agent conversation",
            "description": "Hover a conversation and select the continue icon to resume it at the current project path. Use the title-bar plus button, or a provider group's plus button, to start a fresh Codex, Cursor, or OpenCode session.\n[Resume a conversation](command:threadrelink.resume)",
            "media": {
              "image": "media/guide/05-resumed-terminal.png",
              "altText": "Conversation resumed in an integrated terminal at the new path"
            },
            "completionEvents": [
              "onCommand:threadrelink.resume"
            ]
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "threadrelink.refresh",
          "when": "view == threadrelink.conversations && threadrelink.hasReadyProject",
          "group": "navigation@1"
        },
        {
          "command": "threadrelink.initialize",
          "when": "view == threadrelink.conversations && threadrelink.hasUninitializedProject",
          "group": "navigation@2"
        },
        {
          "command": "threadrelink.findOldConversations",
          "when": "view == threadrelink.conversations && threadrelink.hasReadyProject",
          "group": "navigation@2"
        },
        {
          "command": "threadrelink.startNewSession",
          "when": "view == threadrelink.conversations && threadrelink.hasReadyProject",
          "group": "navigation@2.5"
        },
        {
          "command": "threadrelink.collapseTree",
          "when": "view == threadrelink.conversations && !threadrelink.treeCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "threadrelink.expandTree",
          "when": "view == threadrelink.conversations && threadrelink.treeCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "threadrelink.noHiddenConversations",
          "when": "view == threadrelink.conversations && !threadrelink.hasHiddenConversations && !threadrelink.showingHiddenConversations",
          "group": "navigation@4"
        },
        {
          "command": "threadrelink.showHiddenConversations",
          "when": "view == threadrelink.conversations && threadrelink.hasHiddenConversations && !threadrelink.showingHiddenConversations",
          "group": "navigation@4"
        },
        {
          "command": "threadrelink.hideHiddenConversations",
          "when": "view == threadrelink.conversations && threadrelink.showingHiddenConversations",
          "group": "navigation@4"
        },
        {
          "command": "threadrelink.restoreHiddenConversations",
          "when": "view == threadrelink.conversations && threadrelink.hasHiddenConversations",
          "group": "manage@0"
        },
        {
          "command": "threadrelink.relink",
          "when": "view == threadrelink.conversations && threadrelink.hasReadyProject",
          "group": "manage@1"
        },
        {
          "command": "threadrelink.forgetProject",
          "when": "view == threadrelink.conversations",
          "group": "manage@2"
        },
        {
          "command": "threadrelink.doctor",
          "when": "view == threadrelink.conversations",
          "group": "manage@3"
        }
      ],
      "view/item/context": [
        {
          "command": "threadrelink.startNewSession",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linked\\.(codex|cursor|opencode)\\.launchable$/",
          "group": "inline@1"
        },
        {
          "command": "threadrelink.resume",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor|opencode)\\.launchable(\\.hidden)?$/",
          "group": "inline@1"
        },
        {
          "command": "threadrelink.copyAtPath",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor)\\.(launchable|historyOnly)(\\.hidden)?$/",
          "group": "inline@2"
        },
        {
          "command": "threadrelink.exportOpenCodeAtPath",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.opencode\\.(launchable|historyOnly)(\\.hidden)?$/",
          "group": "inline@2"
        },
        {
          "command": "threadrelink.copyCompactAtPath",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor|opencode)\\.(launchable|historyOnly)(\\.hidden)?$/",
          "group": "manage@3.5"
        },
        {
          "command": "threadrelink.revealLocation",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor)\\.(launchable|historyOnly)(\\.hidden)?$/",
          "group": "manage@3.6"
        },
        {
          "command": "threadrelink.editDescription",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor|opencode)\\.(launchable|historyOnly)(\\.hidden)?$/",
          "group": "manage@2"
        },
        {
          "command": "threadrelink.hideConversation",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor|opencode)\\.(launchable|historyOnly)$/",
          "group": "manage@3"
        },
        {
          "command": "threadrelink.showConversation",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor|opencode)\\.(launchable|historyOnly)\\.hidden$/",
          "group": "manage@3"
        },
        {
          "command": "threadrelink.manageLink",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor|opencode)\\.(launchable|historyOnly)(\\.hidden)?$/",
          "group": "manage@4"
        }
      ]
    },
    "configuration": {
      "title": "ChatAnchor",
      "properties": {
        "threadrelink.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Codex executable name or absolute path."
        },
        "threadrelink.agentPath": {
          "type": "string",
          "default": "agent",
          "description": "Cursor Agent CLI executable name or absolute path (used to resume Cursor conversations)."
        },
        "threadrelink.cursorHome": {
          "type": "string",
          "default": "",
          "description": "Optional Cursor home directory for Agent CLI chats. Leave empty to use CURSOR_HOME or ~/.cursor."
        },
        "threadrelink.opencodePath": {
          "type": "string",
          "default": "opencode",
          "description": "OpenCode executable name or absolute path."
        },
        "threadrelink.opencodeHome": {
          "type": "string",
          "default": "",
          "description": "Optional OpenCode data directory (contains opencode.db). Leave empty to use THREADRELINK_OPENCODE_HOME, XDG_DATA_HOME, or ~/.local/share/opencode."
        },
        "threadrelink.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Refresh metadata for independently detected Codex, Cursor, and OpenCode providers when an explicitly set-up, trusted project opens, after consent."
        },
        "threadrelink.registryHome": {
          "type": "string",
          "default": "",
          "description": "Optional ChatAnchor state directory. Leave empty to use THREADRELINK_HOME or ~/.threadrelink."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "pnpm build && vsce package --no-dependencies --out threadrelink.vsix"
  },
  "devDependencies": {
    "@threadrelink/core": "workspace:*",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.8",
    "vitest": "^3.2.4"
  }
}
