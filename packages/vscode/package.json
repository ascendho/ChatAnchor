{
  "name": "threadrelink",
  "displayName": "ThreadRelink",
  "description": "A VS Code extension that keeps local Codex conversations connected to their projects after repositories are renamed or moved.",
  "version": "0.6.1",
  "icon": "resources/threadrelink.png",
  "publisher": "ascendho",
  "repository": {
    "type": "git",
    "url": "https://github.com/ascendho/ThreadRelink.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/ascendho/ThreadRelink#readme",
  "bugs": {
    "url": "https://github.com/ascendho/ThreadRelink/issues"
  },
  "license": "GPL-3.0-only",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#315EF3",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "conversation",
    "history",
    "repository",
    "rename"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onView:threadrelink.conversations"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "ThreadRelink starts a local Codex process and reads local conversation metadata."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "threadrelink.enable",
        "title": "ThreadRelink: Enable Local Metadata Scan",
        "icon": "$(shield)"
      },
      {
        "command": "threadrelink.openGettingStarted",
        "title": "ThreadRelink: Open Getting Started",
        "icon": "$(book)"
      },
      {
        "command": "threadrelink.openView",
        "title": "ThreadRelink: Open Conversations View",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "threadrelink.initialize",
        "title": "ThreadRelink: Set Up This Project",
        "icon": "$(key)"
      },
      {
        "command": "threadrelink.findOldConversations",
        "title": "ThreadRelink: Find Old Conversations",
        "icon": "$(search)"
      },
      {
        "command": "threadrelink.collapseTree",
        "title": "ThreadRelink: Collapse Conversations",
        "icon": "$(collapse-all)"
      },
      {
        "command": "threadrelink.expandTree",
        "title": "ThreadRelink: Expand Conversations",
        "icon": "$(expand-all)"
      },
      {
        "command": "threadrelink.forgetProject",
        "title": "ThreadRelink: Forget Project",
        "icon": "$(trash)"
      },
      {
        "command": "threadrelink.refresh",
        "title": "ThreadRelink: Refresh Conversations",
        "icon": "$(refresh)"
      },
      {
        "command": "threadrelink.confirmLink",
        "title": "ThreadRelink: Link Conversation to This Project",
        "icon": "$(link)"
      },
      {
        "command": "threadrelink.unlink",
        "title": "ThreadRelink: Remove Conversation from This Project",
        "icon": "$(remove-close)"
      },
      {
        "command": "threadrelink.move",
        "title": "ThreadRelink: Move Conversation to Another Project",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "threadrelink.resume",
        "title": "ThreadRelink: Resume Conversation Here",
        "icon": "$(debug-continue)"
      },
      {
        "command": "threadrelink.copyAtPath",
        "title": "ThreadRelink: Copy @ Conversation Path",
        "icon": "$(mention)"
      },
      {
        "command": "threadrelink.revealLocation",
        "title": "ThreadRelink: Reveal Conversation File",
        "icon": "$(folder-opened)"
      },
      {
        "command": "threadrelink.relink",
        "title": "ThreadRelink: Relink Previous Project Path",
        "icon": "$(folder-symlink)"
      },
      {
        "command": "threadrelink.doctor",
        "title": "ThreadRelink: Run Diagnostics",
        "icon": "$(stethoscope)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "threadrelink",
          "title": "ThreadRelink",
          "icon": "resources/threadrelink.svg"
        }
      ]
    },
    "views": {
      "threadrelink": [
        {
          "id": "threadrelink.conversations",
          "name": "Conversations"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "threadrelink.conversations",
        "contents": "Open a project folder to use ThreadRelink.\n[Open Getting Started](command:threadrelink.openGettingStarted)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "walkthroughs": [
      {
        "id": "threadrelink.gettingStarted",
        "title": "Keep Codex conversations after a project rename",
        "description": "Initialize once, then resume the same local Codex thread from any renamed or moved path.",
        "steps": [
          {
            "id": "threadrelink.gettingStarted.openView",
            "title": "Find ThreadRelink",
            "description": "Open the ThreadRelink icon in the Activity Bar. If it is hidden, right-click the Activity Bar and enable **ThreadRelink**.\n[Open ThreadRelink](command:threadrelink.openView)",
            "media": {
              "image": "media/guide/02-find-threadrelink.png",
              "altText": "ThreadRelink icon highlighted in the VS Code Activity Bar"
            },
            "completionEvents": [
              "onCommand:threadrelink.openView"
            ]
          },
          {
            "id": "threadrelink.gettingStarted.enable",
            "title": "Allow the metadata-only scan",
            "description": "Allow metadata access once for this VS Code profile. New projects are never scanned until you explicitly set them up.\n[Enable metadata scan](command:threadrelink.enable)",
            "media": {
              "image": "media/guide/03-enable-and-initialize.png",
              "altText": "ThreadRelink setup action before a project is scanned"
            },
            "completionEvents": [
              "onCommand:threadrelink.enable"
            ]
          },
          {
            "id": "threadrelink.gettingStarted.initialize",
            "title": "Set up this project explicitly",
            "description": "Store a stable local project ID before renaming or moving the folder. A folder inside a parent Git repository always asks you to choose its boundary.\n[Set Up This Project](command:threadrelink.initialize)",
            "media": {
              "image": "media/guide/03-enable-and-initialize.png",
              "altText": "Set Up This Project action in the ThreadRelink view"
            },
            "completionEvents": [
              "onCommand:threadrelink.initialize"
            ]
          },
          {
            "id": "threadrelink.gettingStarted.reopen",
            "title": "Rename and reopen the folder",
            "description": "Close the Codex terminal, rename the folder outside VS Code, reopen the new path, then refresh ThreadRelink.\n[Refresh conversations](command:threadrelink.refresh)",
            "media": {
              "image": "media/guide/04-resume-after-rename.png",
              "altText": "A renamed project with its linked Codex conversation"
            },
            "completionEvents": [
              "onCommand:threadrelink.refresh"
            ]
          },
          {
            "id": "threadrelink.gettingStarted.resume",
            "title": "Resume the original conversation",
            "description": "Hover a conversation and select the continue icon. ThreadRelink opens `codex resume --cd <new-path> <thread-id>`, `agent --resume <chat-id> --workspace <new-path>`, or `opencode --session <id>` in an integrated terminal.\n[Resume a conversation](command:threadrelink.resume)",
            "media": {
              "image": "media/guide/05-resumed-terminal.png",
              "altText": "Conversation resumed in an integrated terminal at the new path"
            },
            "completionEvents": [
              "onCommand:threadrelink.resume"
            ]
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "threadrelink.refresh",
          "when": "view == threadrelink.conversations && threadrelink.hasReadyProject",
          "group": "navigation@1"
        },
        {
          "command": "threadrelink.initialize",
          "when": "view == threadrelink.conversations && threadrelink.hasUninitializedProject",
          "group": "navigation@2"
        },
        {
          "command": "threadrelink.findOldConversations",
          "when": "view == threadrelink.conversations && threadrelink.hasReadyProject",
          "group": "navigation@2"
        },
        {
          "command": "threadrelink.collapseTree",
          "when": "view == threadrelink.conversations && !threadrelink.treeCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "threadrelink.expandTree",
          "when": "view == threadrelink.conversations && threadrelink.treeCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "threadrelink.relink",
          "when": "view == threadrelink.conversations && threadrelink.hasReadyProject",
          "group": "manage@1"
        },
        {
          "command": "threadrelink.forgetProject",
          "when": "view == threadrelink.conversations",
          "group": "manage@2"
        },
        {
          "command": "threadrelink.doctor",
          "when": "view == threadrelink.conversations",
          "group": "manage@3"
        }
      ],
      "view/item/context": [
        {
          "command": "threadrelink.resume",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor|opencode)$/",
          "group": "inline@1"
        },
        {
          "command": "threadrelink.copyAtPath",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor)$/",
          "group": "inline@2"
        },
        {
          "command": "threadrelink.revealLocation",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor)$/",
          "group": "inline@3"
        },
        {
          "command": "threadrelink.copyAtPath",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor)$/",
          "group": "manage@0"
        },
        {
          "command": "threadrelink.revealLocation",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\.(codex|cursor)$/",
          "group": "manage@1"
        },
        {
          "command": "threadrelink.move",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\./",
          "group": "manage@2"
        },
        {
          "command": "threadrelink.unlink",
          "when": "view == threadrelink.conversations && viewItem =~ /^threadrelink\\.linkedThread\\./",
          "group": "manage@3"
        }
      ]
    },
    "configuration": {
      "title": "ThreadRelink",
      "properties": {
        "threadrelink.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Codex executable name or absolute path."
        },
        "threadrelink.agentPath": {
          "type": "string",
          "default": "agent",
          "description": "Cursor Agent CLI executable name or absolute path (used to resume Cursor conversations)."
        },
        "threadrelink.cursorHome": {
          "type": "string",
          "default": "",
          "description": "Optional Cursor home directory for Agent CLI chats. Leave empty to use CURSOR_HOME or ~/.cursor."
        },
        "threadrelink.opencodePath": {
          "type": "string",
          "default": "opencode",
          "description": "OpenCode executable name or absolute path."
        },
        "threadrelink.opencodeHome": {
          "type": "string",
          "default": "",
          "description": "Optional OpenCode data directory (contains opencode.db). Leave empty to use THREADRELINK_OPENCODE_HOME, XDG_DATA_HOME, or ~/.local/share/opencode."
        },
        "threadrelink.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Refresh local Codex and Cursor conversation metadata when an explicitly set-up, trusted project opens, after consent."
        },
        "threadrelink.registryHome": {
          "type": "string",
          "default": "",
          "description": "Optional ThreadRelink state directory. Leave empty to use THREADRELINK_HOME or ~/.threadrelink."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "pnpm build && vsce package --no-dependencies --out threadrelink.vsix"
  },
  "devDependencies": {
    "@threadrelink/core": "workspace:*",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.8",
    "vitest": "^3.2.4"
  }
}
